{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.cloudflare",
      "!!**/dist",
      "!!**/node_modules",
      "!!tmp"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "markdown": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  }
}
